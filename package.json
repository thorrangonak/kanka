{
  "name": "@thorrangonak/kanka",
  "version": "0.1.0",
  "description": "kanka — Türkçe konuşan terminal kodlama asistanı. 'Kanka, şunu yapsana.'",
  "type": "module",
  "bin": {
    "kanka": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && shx chmod +x dist/cli.js",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "clean": "shx rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.74.1",
    "chalk": "^5.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "shx": "^0.4.0",
    "typescript": "^5.7.3"
  },
  "keywords": [
    "kanka",
    "coding-agent",
    "ai",
    "llm",
    "cli",
    "turkish",
    "türkçe",
    "kodlama-asistanı"
  ],
  "author": "thorrangonak",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thorrangonak/kanka.git"
  },
  "homepage": "https://github.com/thorrangonak/kanka",
  "bugs": {
    "url": "https://github.com/thorrangonak/kanka/issues"
  },
  "engines": {
    "node": ">=20.6.0"
  }
}
